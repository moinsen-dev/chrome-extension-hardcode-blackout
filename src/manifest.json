{
  "manifest_version": 3,
  "name": "Hardcore Blackout",
  "version": "1.0.0",
  "description": "A sophisticated Chrome extension for content filtering with local AI processing",
  "permissions": ["storage", "history", "webNavigation", "scripting"],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.facebook.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
